# --- NOIRXU AI itself ---
NOIRXU_AI_OWNER_PASSWORD=replace_me
NOIRXU_AI_SESSION_SECRET=replace_with_32_plus_random_chars
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOIRXU_TOKEN_ENCRYPTION_KEY=
# Hub storage: Postgres URL for the limited noirxu_ai_app role (Supabase pooler). Required in production.
# postgresql://noirxu_ai_app.<project-ref>:<password>@<pooler-host>:6543/postgres
NOIRXU_AI_DATABASE_URL=
ANTHROPIC_API_KEY=
# NOIRXU_AI_MODEL=claude-opus-5-5
# OpenAI (chat can run on OpenAI instead of Claude). With only OPENAI_API_KEY set, OpenAI is used.
# NOIRXU_AI_PROVIDER picks one when both keys exist: anthropic | openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium        # low | medium | high (reasoning models only)
# OPENAI_PRICE_INPUT_PER_M=             # USD per 1M tokens, for cost estimates and caps
# OPENAI_PRICE_OUTPUT_PER_M=
# NOIRXU_AI_PROVIDER=
# Personal-assistant features are on by default. To switch any of them off, list them here:
# triage, commands, briefings, reply_drafts
# NOIRXU_AI_DISABLED_FEATURES=

# --- NOIRXU Ledger (public anon key; access is the signed-in user's own, under RLS) ---
LEDGER_SUPABASE_URL=https://orhajhbelqztiqhhniwn.supabase.co
LEDGER_SUPABASE_ANON_KEY=
LEDGER_APP_URL=https://ledger.noirxu.com

# --- NOIRXU Trading Journal (same Supabase project as Ledger) ---
JOURNAL_SUPABASE_URL=https://orhajhbelqztiqhhniwn.supabase.co
JOURNAL_SUPABASE_ANON_KEY=
JOURNAL_APP_URL=

# --- NOIRXU RADAR (needs the feature/ai-integration-api branch deployed) ---
RADAR_INTEGRATION_URL=
RADAR_INTEGRATION_TOKEN=
RADAR_APP_URL=

# --- Gmail (your own Google Cloud OAuth client) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<your-domain>/api/connections/gmail/callback
