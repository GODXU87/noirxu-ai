# --- NOIRXU AI itself ---
NOIRXU_AI_OWNER_PASSWORD=replace_me
NOIRXU_AI_SESSION_SECRET=replace_with_32_plus_random_chars
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOIRXU_TOKEN_ENCRYPTION_KEY=
# NOIRXU AI's OWN Supabase project (connections, proposals, audit log). Required in production.
NOIRXU_AI_SUPABASE_URL=
NOIRXU_AI_SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# NOIRXU_AI_MODEL=claude-opus-5-5

# --- NOIRXU Ledger (public anon key; access is the signed-in user's own, under RLS) ---
LEDGER_SUPABASE_URL=https://orhajhbelqztiqhhniwn.supabase.co
LEDGER_SUPABASE_ANON_KEY=
LEDGER_APP_URL=https://ledger.noirxu.com

# --- NOIRXU Trading Journal (public anon key) ---
JOURNAL_SUPABASE_URL=
JOURNAL_SUPABASE_ANON_KEY=
JOURNAL_APP_URL=

# --- NOIRXU RADAR (needs the feature/ai-integration-api branch deployed) ---
RADAR_INTEGRATION_URL=
RADAR_INTEGRATION_TOKEN=
RADAR_APP_URL=

# --- Gmail (your own Google Cloud OAuth client) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<your-domain>/api/connections/gmail/callback
